---
import { SEO } from 'astro-seo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Jamila M. Brown, PsyD - Clinical Psychologist" } = Astro.props;
const settingsEntry = await getEntry('pages', 'settings');
const settings = settingsEntry?.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{gaId && <GoogleAnalytics measurementId={gaId} />}
		<SEO
			title={title}
			titleTemplate="%s | Jamila M. Brown, PsyD"
			description={description}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					title: `${title} | Jamila M. Brown, PsyD`,
					type: "website",
					image: "/favicon.svg",
					url: canonicalURL.toString(),
				},
				optional: {
					siteName: "Jamila M. Brown, PsyD",
					description: description,
				}
			}}
			twitter={{
				card: "summary_large_image",
				title: `${title} | Jamila M. Brown, PsyD`,
				description: description,
				image: "/favicon.svg",
			}}
		/>
	</head>
	<body class="bg-accent text-text font-inter antialiased min-h-screen flex flex-col">
    <Header settings={settings} />
		<main class="flex-grow">
      <slot />
    </main>
    <Footer settings={settings} />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

	.font-inter {
		font-family: var(--font-inter);
	}
	.font-montserrat {
		font-family: var(--font-montserrat);
	}
</style>
